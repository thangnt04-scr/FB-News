# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False

# Security
SECRET_KEY=4298703a446bbf0d3c91a79c8ed938731557f31c201578a970cdf0367d1b27dc
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Database
DATABASE_URL=sqlite:///footballinfor.db

# Football API
FOOTBALL_DATA_API_KEY=714b8b0227af4ae7bec7cd46e191cf3a

# Data Population
# Set to True to fetch ALL data (3,600+ records, takes 30-60 min)
# Set to False for limited data (71 records, takes ~5 min)
FETCH_ALL_DATA=True

# Security Headers
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net; img-src 'self' data: https:;

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS (if needed)
CORS_ENABLED=false
CORS_ORIGINS=*

# Application Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Email (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Admin Settings
ADMIN_EMAIL=admin@football.com
ADMIN_USERNAME=admin

# Cloud Deployment
CLOUD_PROVIDER=aws
REGION=us-east-1

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Redis (if using for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# Celery (if using for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

